# ============================================================
# .gitignore — PasFotoIn
# Aturan: hanya file sumber, konfigurasi, dan dokumentasi yang
# di-push. Semua artefak build, cache, dan data lokal diabaikan.
# ============================================================

# ---------- Dependensi ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build output Next.js ----------
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ---------- Hasil pengujian ----------
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/.playwright-artifacts

# ---------- Cache & tooling ----------
.eslintcache
.stylelintcache
.turbo
.nx
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Environment & rahasia ----------
# Jangan pernah push kredensial. Bila butuh contoh, buat .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
.npmrc
.pypirc
.netrc
secrets.json
credentials.json
serviceAccount*.json

# ---------- Editor & OS ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# ---------- Deploy ----------
.vercel
.netlify

# ---------- Data lokal aplikasi (bila ada ekspor manual) ----------
# Aplikasi menyimpan data di IndexedDB peramban, bukan di repo.
# Folder ini hanya untuk ekspor/impor manual saat debugging.
/local-data
/exports

# ---------- Catatan pribadi ----------
# Jangan commit catatan kerja pribadi atau draf desain.
/notes
/TODO.local.md

# ---------- Dokumen kerja internal ----------
# Dokumen perencanaan, riset, dan catatan agen tidak untuk repo publik.
# Dibiarkan ada di perangkat, tapi tidak ikut ter-push.
AGENTS.md
*- Breakdown Fitur untuk Redesign.md
/PRD*.md
/drafts

# ---------- Arsip & cadangan lokal ----------
# Jangan commit cadangan, dump, atau arsip yang mungkin berisi data nyata.
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.bak
*.orig
*.rej
*.sql
*.sqlite
*.sqlite3
*.db

# ---------- Data foto pengguna ----------
# Foto uji sintetis di tests/fixtures tetap diizinkan lewat pengecualian di bawah.
# Foto asli pengguna tidak boleh masuk repo.
*.jpg
*.jpeg
*.heic
*.heif
*.avif
!tests/fixtures/*
!src/app/*.ico
