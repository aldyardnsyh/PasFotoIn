# ============================================================
# .gitignore — PasFotoIn
# Aturan: hanya file sumber, konfigurasi, dan dokumentasi yang
# di-push. Semua artefak build, cache, dan data lokal diabaikan.
# ============================================================

# ---------- Dependensi ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build output Next.js ----------
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ---------- Hasil pengujian ----------
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/.playwright-artifacts

# ---------- Cache & tooling ----------
.eslintcache
.stylelintcache
.turbo
.nx
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Environment & rahasia ----------
# Jangan pernah push kredensial. Bila butuh contoh, buat .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------- Editor & OS ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# ---------- Deploy ----------
.vercel
.netlify

# ---------- Data lokal aplikasi (bila ada ekspor manual) ----------
# Aplikasi menyimpan data di IndexedDB peramban, bukan di repo.
# Folder ini hanya untuk ekspor/impor manual saat debugging.
/local-data
/exports

# ---------- Catatan pribadi ----------
# Jangan commit catatan kerja pribadi atau draf desain.
/notes
/TODO.local.md
